@model Org.Ktu.Isk.P175B602.Autonuoma.Models.Modelis.MokinysCE

@* this will also be used as page title in main layout *@
@{ ViewData["title"] = "Mokinio redagavimas"; }

@* content header *@
<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>

@* content itself *@
<div class="main-content-ced">
@using( Html.BeginForm(FormMethod.Post, new { @class="entity-ce" }) )
{
	@Html.AntiForgeryToken()

	@Html.ValidationSummary(true, "", new { @class = "text-danger" })

	@* add hidden form fields for non-visible properties, otherwise they will get lost in code that handles button presses *@
	@Html.HiddenFor(m => m.Mokinys.Id)

	<fieldset>
			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.Vardas)
				@Html.EditorFor(m => m.Mokinys.Vardas)
				@Html.ValidationMessageFor(m => m.Mokinys.Vardas, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.Pavarde)
				@Html.EditorFor(m => m.Mokinys.Pavarde)
				@Html.ValidationMessageFor(m => m.Mokinys.Pavarde, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.Klase)
				@Html.EditorFor(m => m.Mokinys.Klase)
				@Html.ValidationMessageFor(m => m.Mokinys.Klase, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.El_pastas)
				@Html.EditorFor(m => m.Mokinys.El_pastas)
				@Html.ValidationMessageFor(m => m.Mokinys.El_pastas, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.Tel_numeris)
				@Html.EditorFor(m => m.Mokinys.Tel_numeris)
				@Html.ValidationMessageFor(m => m.Mokinys.Tel_numeris, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.Registracijos_data)
				@Html.EditorFor(m => m.Mokinys.Registracijos_data, new { htmlAttributes = new { @class = "date-picker" } })
				@Html.ValidationMessageFor(m => m.Mokinys.Registracijos_data, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokinys.FkMokinioAtstovas)
				@Html.DropDownListFor(m => m.Mokinys.FkMokinioAtstovas, Model.Lists.Atstovai, (string)ViewData["none-chosen"])
				@Html.ValidationMessageFor(m => m.Mokinys.FkMokinioAtstovas, "")
			</div>
	</fieldset>

	<div class="container-fluid d-flex d-row justify-content-end">
		<button name="save" value="1" class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Išsaugoti</button>
	</div>
}
</div>

@* content footer *@
<div class="main-content-footer">
	<span class="title"></span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>
