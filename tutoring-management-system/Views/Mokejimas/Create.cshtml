@model Org.Ktu.Isk.P175B602.Autonuoma.Models.Mokejimas

@* this will also be used as page title in main layout *@
@{ ViewData["title"] = "Mokėjimo sukūrimas"; }

@* content header *@
<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>

@* content itself *@
<div class="main-content-ced">
@using( Html.BeginForm(FormMethod.Post, new { @class="entity-ce" }) )
{
	@Html.AntiForgeryToken()
	
	@Html.ValidationSummary(true, "", new { @class = "text-danger" })
	
	<fieldset>
			<div class="form-group">
				@Html.LabelFor(m => m.Suma)
				@Html.EditorFor(m => m.Suma)
				@Html.ValidationMessageFor(m => m.Suma, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Paskirtis)
				@Html.EditorFor(m => m.Paskirtis)
				@Html.ValidationMessageFor(m => m.Paskirtis, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Data)
				@Html.EditorFor(m => m.Data)
				@Html.ValidationMessageFor(m => m.Data, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Saskaitos_numeris)
				@Html.EditorFor(m => m.Saskaitos_numeris)
				@Html.ValidationMessageFor(m => m.Saskaitos_numeris, "")
			</div>

			
			<div class="form-group">
				@Html.LabelFor(m => m.Fk_Mokinys)
				@Html.EditorFor(m => m.Fk_Mokinys)
				@Html.ValidationMessageFor(m => m.Fk_Mokinys, "")
			</div>
	</fieldset>

	<div class="container-fluid d-flex d-row justify-content-end">
		<button name="save" value="1" class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Išsaugoti</button>
	</div>
}
</div>

@* content footer *@
<div class="main-content-footer">
	<span class="title"></span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>