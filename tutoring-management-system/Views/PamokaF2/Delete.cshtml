@model Org.Ktu.Isk.P175B602.Autonuoma.Models.SutartisF2.PamokaCE

@* this will also be used as page title in main layout *@
@{
	ViewData["title"] = "Pamokos šalinimas (F2)";
}


<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a href="@Url.Action("Index")"
		   class="btn btn-outline-primary btn-sm">
			<i class="fa-solid fa-angles-left"></i> Atgal į sąrašą
		</a>
	</span>
</div>


<div class="main-content-ced">
	@using (Html.BeginForm(FormMethod.Post, new { @class = "entity-d" }))
	{
		@Html.AntiForgeryToken()

		<fieldset>
			<legend class="confirm-msg">Ar tikrai norite šalinti šią pamoką ir visą jos mokomąją medžiagą?</legend>

			<dl>
				<dt>@Html.DisplayNameFor(m => m.Pamoka.Id)</dt>
				<dd>@Html.DisplayFor(m => m.Pamoka.Id)</dd>

				<dt>@Html.DisplayNameFor(m => m.Pamoka.FkMokinys)</dt>
				<dd>@Html.DisplayFor(m => m.Pamoka.FkMokinys)</dd>

				<dt>@Html.DisplayNameFor(m => m.Pamoka.FkKorepetitorius)</dt>
				<dd>@Html.DisplayFor(m => m.Pamoka.FkKorepetitorius)</dd>
			</dl>

			@if (ViewData["deletionNotPermitted"] != null)
			{
				<div class="fail-msg">
					<i class="fa-solid fa-circle-exclamation"></i> Šios pamokos pašalinti negalima,
					nes su ja yra susieti kiti svarbūs sistemos duomenys (pvz., atlikti mokėjimai).
				</div>
			}
			else
			{
				<div class="buttons">
					<button formaction="@Url.Action("DeleteConfirm", new {id = Model.Pamoka.Id})"
							class="btn btn-danger"
							style="white-space: nowrap;">
						<i class="fa-solid fa-trash"></i> Šalinti
					</button>
				</div>
			}
		</fieldset>
	}
</div>

<div class="main-content-footer">
	<span class="title"></span>
	<span class="actions">
		<a href="@Url.Action("Index")"
		   class="btn btn-outline-primary btn-sm">
			<i class="fa-solid fa-angles-left"></i> Atgal į sąrašą
		</a>
	</span>
</div>