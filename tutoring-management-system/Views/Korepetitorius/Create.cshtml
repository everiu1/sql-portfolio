@model Org.Ktu.Isk.P175B602.Autonuoma.Models.Korepetitorius

@* this will also be used as page title in main layout *@
@{ ViewData["title"] = "Korepetitoriaus sukūrimas"; }

@* content header *@
<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>

@* content itself *@
<div class="main-content-ced">
@using( Html.BeginForm(FormMethod.Post, new { @class="entity-ce" }) )
{
	@Html.AntiForgeryToken()

	@Html.ValidationSummary(true, "", new { @class = "text-danger" })

	<fieldset>
		<div class="form-group">
				@Html.LabelFor(m => m.Vardas)
				@Html.EditorFor(m => m.Vardas)
				@Html.ValidationMessageFor(m => m.Vardas, "")
		</div>

		<div class="form-group">
				@Html.LabelFor(m => m.Pavarde)
				@Html.EditorFor(m => m.Pavarde)
				@Html.ValidationMessageFor(m => m.Pavarde, "")
		</div>

			<div class="form-group">
				@Html.LabelFor(m => m.El_pastas)
				@Html.EditorFor(m => m.El_pastas)
				@Html.ValidationMessageFor(m => m.El_pastas, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Tel_numeris)
				@Html.EditorFor(m => m.Tel_numeris)
				@Html.ValidationMessageFor(m => m.Tel_numeris, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Valandos_per_savaite)
				@Html.EditorFor(m => m.Valandos_per_savaite)
				@Html.ValidationMessageFor(m => m.Valandos_per_savaite, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Aprasymas)
				@Html.EditorFor(m => m.Aprasymas)
				@Html.ValidationMessageFor(m => m.Aprasymas, "")
			</div>

			<div class="form-group">
				@Html.LabelFor(m => m.Mokymo_patirtis)
				@Html.EditorFor(m => m.Mokymo_patirtis)
				@Html.ValidationMessageFor(m => m.Mokymo_patirtis, "")
			</div>

		
	</fieldset>

	<div class="container-fluid d-flex d-row justify-content-end">
		<button name="save" value="1" class="btn btn-success"><i class="fa-solid fa-floppy-disk"></i> Išsaugoti</button>
	</div>
}
</div>

@* content footer *@
<div class="main-content-footer">
	<span class="title"></span>
	<span class="actions">
		<a 
			href="@Url.Action("Index")" 
			class="btn btn-outline-primary btn-sm"
		>
			<i class="fa-solid fa-angles-left"></i> Atgal į sarašą
		</a>
	</span>
</div>