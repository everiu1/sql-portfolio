@model Org.Ktu.Isk.P175B602.Autonuoma.Models.Paslauga.Mokomoji_medizaga

@* this will also be used as page title in main layout *@
@{
	ViewData["title"] = "Mokomosios medizagos šalinimas";
}


<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a href="@Url.Action("Index")"
		   class="btn btn-outline-primary btn-sm">
			<i class="fa-solid fa-angles-left"></i> Atgal į sąrašą
		</a>
	</span>
</div>

<div class="main-content-ced">
	@using (Html.BeginForm(FormMethod.Post, new { @class = "entity-d" }))
	{
		@Html.AntiForgeryToken()

		<fieldset>
			<legend class="confirm-msg">Ar tikrai norite šalinti šią mokomąją medizagą?</legend>

			<dl>
				<dt>@Html.DisplayNameFor(m => m.Id)</dt>
				<dd>@Html.DisplayFor(m => m.Id)</dd>

				<dt>@Html.DisplayNameFor(m => m.Dalykas)</dt>
				<dd>@Html.DisplayFor(m => m.Dalykas)</dd>

				<dt>@Html.DisplayNameFor(m => m.Pavadinimas)</dt>
				<dd>@Html.DisplayFor(m => m.Pavadinimas)</dd>

				<dt>@Html.DisplayNameFor(m => m.Klase)</dt>
				<dd>@Html.DisplayFor(m => m.Klase)</dd>

				<dt>@Html.DisplayNameFor(m => m.Tipas)</dt>
				<dd>@Html.DisplayFor(m => m.Tipas)</dd>

				<dt>@Html.DisplayNameFor(m => m.Dalis)</dt>
				<dd>@Html.DisplayFor(m => m.Dalis)</dd>
			</dl>

			@if (ViewData["deletionNotPermitted"] != null)
			{
				<div class="fail-msg">
					<i class="fa-solid fa-circle-exclamation"></i> Šios mokomosios medizagos pašalinti negalima[cite: 9, 250],
					nes ji yra susieta su vykstančiomis ar suplanuotomis pamokomis.
				</div>
			}
			else
			{
				<div class="buttons">
					<button formaction="@Url.Action("DeleteConfirm", new {id = Model.Id})"
							class="btn btn-danger"
							style="white-space: nowrap;">
						<i class="fa-solid fa-trash"></i> Šalinti
					</button>
				</div>
			}
		</fieldset>
	}
</div>


<div class="main-content-footer">
	<span class="title"></span>
	<span class="actions">
		<a href="@Url.Action("Index")"
		   class="btn btn-outline-primary btn-sm">
			<i class="fa-solid fa-angles-left"></i> Atgal į sąrašą
		</a>
	</span>
</div>