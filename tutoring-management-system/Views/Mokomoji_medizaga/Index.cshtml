@model IEnumerable<Org.Ktu.Isk.P175B602.Autonuoma.Models.Paslauga.Mokomoji_medizaga>

@* this will also be used as page title in main layout *@
@{
	ViewData["title"] = "Mokomosios medizagos";
}


<div class="main-content-header">
	<span class="title">@ViewData["title"]</span>
	<span class="actions">
		<a href="@Url.Action("Create")" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Sukurti naują</a>
	</span>
</div>


<div class="main-content-lst">
	<table class="entity-list">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Id)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Dalykas)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Pavadinimas)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Klase)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Tipas)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Dalis)
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Id)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Dalykas)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Pavadinimas)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Klase)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Tipas)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Dalis)
					</td>
					<td>
						<a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-primary"><i class="fa-solid fa-pen-to-square"></i> Redaguoti</a>
						<a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Šalinti</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>